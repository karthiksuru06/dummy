# ==========================================
# MediConnect Frontend Environment Variables
# ==========================================

# API Configuration
# Production: https://your-backend-app.onrender.com
# Development: http://localhost:5000
REACT_APP_API_BASE=https://your-backend-app.onrender.com

# Socket.io Configuration
# Must match the backend URL
# Production: https://your-backend-app.onrender.com
# Development: http://localhost:5000
REACT_APP_SOCKET_URL=https://your-backend-app.onrender.com

# Feature Flags (Optional)
REACT_APP_ENABLE_CHATBOT=true
REACT_APP_ENABLE_ANALYTICS=false

# Error Monitoring (Optional)
# Sentry DSN for frontend error tracking. Leave unset to disable Sentry entirely
# (no-ops in dev/test). When set, errors are reported to your Sentry project.
# REACT_APP_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0