# MEDviz backend configuration. Copy to .env and fill in real values.
# Never commit the resulting .env.

PORT=5000                                   # HTTP port the Express server listens on
MONGODB_URI=mongodb://localhost:27017/medviz # MongoDB connection string (required)
JWT_SECRET=change-me-to-a-32+char-random-secret # auth signing secret; MUST be >=32 chars (required)
CORS_ORIGIN=http://localhost:3000           # allowed browser origin for CORS

OLLAMA_URL=http://localhost:11434           # base URL of the Ollama LLM server
OLLAMA_MODEL=llama3                          # Ollama model name (must be pulled first)
CHAT_TIMEOUT_MS=30000                        # per-request timeout for LLM chat calls (ms)
CHAT_RETRIES=2                               # retry attempts for failed LLM chat calls

OTP_EXPIRY=300                               # one-time-password validity window (seconds)
SMTP_EMAIL=you@example.com                   # SMTP/Gmail account used to send mail
SMTP_PASSWORD=your-smtp-app-password         # SMTP app password (keep secret)

ADMIN_REGISTRATION_SECRET=change-me          # shared secret required to register an admin
