# ==========================================
# MediConnect Backend Environment Variables
# ==========================================

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=5000

# Database Connection (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mediconnect?retryWrites=true&w=majority

# Authentication & Security
# MUST be at least 32 characters long. Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long_here
JWT_EXPIRES_IN=7d

# CORS & Frontend URLs (Required for production)
# Vercel production URL (e.g., https://your-app.vercel.app)
CORS_ORIGIN=https://your-app.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# AI / Chatbot Configuration
# The triage chatbot uses the Google Gemini API (services/ai.js → callAI).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Legacy (no longer used) ---
# The chatbot previously used a local Ollama server. These are kept for
# reference only and are NOT read by the current code.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# CHAT_TIMEOUT_MS=120000
# CHAT_RETRIES=2

# Email Configuration (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=MEDviz <noreply@yourdomain.com>

# File Uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_FILE_SIZE=10485760 # 10MB in bytes

# Logging
LOG_LEVEL=info

# Error Tracking (OPTIONAL — Sentry)
# When set, runtime errors are reported to Sentry (app.js). When UNSET, Sentry
# is completely inert and behavior is unchanged. Get a DSN at https://sentry.io
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Redis (OPTIONAL — enables horizontal scaling)
# When set, per-instance state moves to Redis so the backend can run multiple
# instances behind a load balancer: chatbot conversation state, socket.io
# fan-out (pub/sub adapter), shared rate-limit counters, and cron leader-locks.
# When UNSET, everything falls back to the in-memory single-instance behavior.
# REDIS_URL=redis://localhost:6379